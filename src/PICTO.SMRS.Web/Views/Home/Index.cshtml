@using PICTO.SMRS.Web.Models.Inventory
@model PICTO.SMRS.Web.Models.HomeDashboardViewModel
@{
    ViewData["Title"] = "Master Dashboard";
}

<div class="smrs-page smrs-page--wide smrs-dashboard">
    <section class="smrs-card smrs-card--page smrs-card--tight">
        <header class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h1 class="h3 text-navy mb-0">Master Dashboard</h1>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-primary">Reports</a>
            </div>
        </header>
    </section>

    <section class="smrs-dashboard-groups mt-3">
        <article class="smrs-card smrs-card--page smrs-card--tight">
            <h2 class="smrs-dashboard-group-title">Workflow queues</h2>
            <div class="smrs-dashboard-kpis">
                @if (Model.ShowPendingApprovals)
                {
                    if (Model.ShowSplitPendingApprovals)
                    {
                        <a asp-controller="Requisitions" asp-action="Approvals" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                            <span class="smrs-dashboard-kpi__label">Pending IT Approvals</span>
                            <strong class="smrs-dashboard-kpi__value">@Model.PendingItApprovals</strong>
                        </a>
                        <a asp-controller="Requisitions" asp-action="Approvals" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                            <span class="smrs-dashboard-kpi__label">Pending Office Approvals</span>
                            <strong class="smrs-dashboard-kpi__value">@Model.PendingOfficeApprovals</strong>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Requisitions" asp-action="Approvals" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                            <span class="smrs-dashboard-kpi__label">@Model.PendingApprovalsLabel</span>
                            <strong class="smrs-dashboard-kpi__value">@Model.PendingApprovals</strong>
                        </a>
                    }
                }
                @if (Model.ShowRequisitionCheckingQueues)
                {
                    <a asp-controller="Requisitions" asp-action="Checker" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                        <span class="smrs-dashboard-kpi__label">Checking Queue</span>
                        <strong class="smrs-dashboard-kpi__value">@Model.PendingCheckingQueue</strong>
                    </a>
                    <a asp-controller="Requisitions" asp-action="Issuance" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                        <span class="smrs-dashboard-kpi__label">Pending Issuance</span>
                        <strong class="smrs-dashboard-kpi__value">@Model.PendingIssuance</strong>
                    </a>
                }
                @if (Model.ShowPendingBorrowRequests)
                {
                    <a asp-controller="Borrow" asp-action="Index" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                        <span class="smrs-dashboard-kpi__label">Pending Borrow Request</span>
                        <strong class="smrs-dashboard-kpi__value">@Model.PendingBorrowRequests</strong>
                    </a>
                }
                @if (Model.ShowBorrowDashboardInfo)
                {
                    <a asp-controller="Borrow" asp-action="Approvals" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                        <span class="smrs-dashboard-kpi__label">Pending Borrow Approval</span>
                        <strong class="smrs-dashboard-kpi__value">@Model.PendingBorrowApprovals</strong>
                    </a>
                }
            </div>
        </article>

        <article class="smrs-card smrs-card--page smrs-card--tight">
            <h2 class="smrs-dashboard-group-title">Inventory overview</h2>
            <div class="smrs-dashboard-kpis">
                <a asp-controller="Inventory" asp-action="Index" asp-route-column="supplygroup" asp-route-q="IT Supplies" asp-route-lowStock="true" asp-route-sort="available" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                    <span class="smrs-dashboard-kpi__label">IT Supplies</span>
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <strong class="smrs-dashboard-kpi__value">@Model.ItUnitsUsed</strong>
                            <span class="d-block small text-muted">In use</span>
                        </div>
                        <div class="text-end">
                            <strong class="smrs-dashboard-kpi__value">@Model.ItLowStockItems</strong>
                            <span class="d-block small text-muted">Low in stock</span>
                        </div>
                    </div>
                </a>
                <a asp-controller="Inventory" asp-action="Index" asp-route-column="supplygroup" asp-route-q="Office Supplies" asp-route-lowStock="true" asp-route-sort="available" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                    <span class="smrs-dashboard-kpi__label">Office Supplies</span>
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <strong class="smrs-dashboard-kpi__value">@Model.OfficeUnitsUsed</strong>
                            <span class="d-block small text-muted">In use</span>
                        </div>
                        <div class="text-end">
                            <strong class="smrs-dashboard-kpi__value">@Model.OfficeLowStockItems</strong>
                            <span class="d-block small text-muted">Low in stock</span>
                        </div>
                    </div>
                </a>
                @if (Model.ShowBorrowDashboardInfo)
                {
                    <a asp-controller="Borrow" asp-action="Approvals" class="smrs-dashboard-kpi smrs-dashboard-kpi--link">
                        <span class="smrs-dashboard-kpi__label">Borrowed Items</span>
                        <strong class="smrs-dashboard-kpi__value">@Model.BorrowedItems</strong>
                    </a>
                }
            </div>
        </article>

        @if (Model.LowStockItems.Count > 0)
        {
            <article class="smrs-card smrs-card--page smrs-card--tight">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <h2 class="smrs-dashboard-group-title mb-0">
                        <svg class="me-1" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#dc3545;vertical-align:text-bottom"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        Low stock items
                        <span class="badge text-bg-danger ms-1">@Model.LowStockItems.Count</span>
                    </h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Type</th>
                                <th class="text-end">Available</th>
                                <th class="text-end">Threshold</th>
                                <th>Low since</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.LowStockItems)
                            {
                                var isZero = item.AvailableQuantity == 0;
                                <tr class="@(isZero ? "table-danger" : "table-warning")">
                                    <td>
                                        <a asp-controller="Inventory" asp-action="Index" asp-route-q="@item.ItemName" class="text-decoration-none fw-semibold">
                                            @item.ItemName
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(item.Brand))
                                        {
                                            <span class="text-muted small">(@item.Brand)</span>
                                        }
                                    </td>
                                    <td>@(item.SupplyGroup == SupplyGroup.ItSupplies ? "IT" : "Office")</td>
                                    <td class="text-end fw-bold @(isZero ? "text-danger" : "")">@item.AvailableQuantity</td>
                                    <td class="text-end text-muted">@item.LowStockLevel</td>
                                    <td>
                                        @if (item.LowStockSince is { } since)
                                        {
                                            <span class="small">@since.LocalDateTime.ToString("yyyy-MM-dd")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </section>
</div>
