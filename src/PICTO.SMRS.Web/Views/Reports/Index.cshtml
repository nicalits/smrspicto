@using PICTO.SMRS.Web.Models.Inventory
@model PICTO.SMRS.Web.Models.Reports.ReportsIndexViewModel
@{
    ViewData["Title"] = "Reports";

    var supplyRequestTotal = Model.ItRequestsInRange + Model.OfficeRequestsInRange;
    var itRequestPercent = supplyRequestTotal == 0
        ? 0
        : (int)Math.Round(Model.ItRequestsInRange * 100m / supplyRequestTotal);
    var officeRequestPercent = supplyRequestTotal == 0 ? 0 : 100 - itRequestPercent;

    var maxRequestCount = Math.Max(Model.RequisitionsInRange, Model.BorrowRequestsInRange);
    var rangeLabel = $"{Model.StartDate:yyyy-MM-dd} to {Model.EndDate:yyyy-MM-dd}";
}

<div class="smrs-page smrs-page--wide smrs-reports">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <h1 class="h3 text-navy mb-1">Reports and Analytics</h1>
                <div class="text-muted small">Accountability Lookup</div>
            </div>
        </header>

        <section class="smrs-section mt-4">
            <form method="get" class="row g-3 align-items-end smrs-report-filter">
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small text-muted text-uppercase tracking-wide" for="repStart">Start Date</label>
                    <input id="repStart" name="startDate" type="date" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small text-muted text-uppercase tracking-wide" for="repEnd">End Date</label>
                    <input id="repEnd" name="endDate" type="date" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <button type="submit" class="btn btn-primary w-100 w-md-auto">Apply Filters</button>
                </div>
            </form>
        </section>

        <section class="smrs-section mt-4">
            <div class="smrs-dashboard-kpis smrs-report-kpis">
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Transactions Today</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.TotalTransactionsToday</strong>
                    <div class="smrs-report-kpi__note">Requisitions + Borrows today</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Employee Requestors</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.TotalEmployeeRequestors</strong>
                    <div class="smrs-report-kpi__note">Unique employees in range</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Units In Use</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.InUseUnits</strong>
                    <div class="smrs-report-kpi__note">Issued requisition units</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Units Out For Borrowing</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.UnitsOutForBorrowing</strong>
                    <div class="smrs-report-kpi__note">Approved borrowed units</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Pending Requisitions</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.PendingRequisitions</strong>
                    <div class="smrs-report-kpi__note">Waiting for approval</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Requisitions (Range)</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.RequisitionsInRange</strong>
                    <div class="smrs-report-kpi__note">@rangeLabel</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Inventory Value</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.InventoryValue.ToPeso()</strong>
                    <div class="smrs-report-kpi__note">All inventory items</div>
                </article>
                <article class="smrs-dashboard-kpi smrs-report-kpi">
                    <span class="smrs-dashboard-kpi__label">Cost (Range)</span>
                    <strong class="smrs-dashboard-kpi__value">@Model.CostInRange.ToPeso()</strong>
                    <div class="smrs-report-kpi__note">Approved requisitions only</div>
                </article>
            </div>
        </section>

        <section class="smrs-section mt-4">
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="smrs-card smrs-card--page smrs-card--tight h-100">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                            <div>
                                <h2 class="h6 text-uppercase text-muted mb-1">IT vs Office Requests</h2>
                                <div class="small text-muted">@Model.StartDate.ToString("yyyy-MM-dd") to @Model.EndDate.ToString("yyyy-MM-dd")</div>
                            </div>
                            <span class="badge text-bg-light">@supplyRequestTotal total</span>
                        </div>

                        @if (supplyRequestTotal == 0)
                        {
                            <div class="smrs-chart-empty">No requisition request data for this range.</div>
                        }
                        else
                        {
                            <div class="smrs-report-chart-wrap">
                                <canvas id="requestsPieChart"
                                        class="smrs-report-chart smrs-report-chart--pie"
                                        data-it="@Model.ItRequestsInRange"
                                        data-office="@Model.OfficeRequestsInRange"
                                        aria-label="IT requests @Model.ItRequestsInRange, office requests @Model.OfficeRequestsInRange">
                                </canvas>
                                <div class="smrs-chart-legend">
                                    <div class="smrs-chart-legend__item">
                                        <span class="smrs-chart-legend__swatch smrs-chart-legend__swatch--it"></span>
                                        <span>IT Requests</span>
                                        <strong>@Model.ItRequestsInRange (@itRequestPercent%)</strong>
                                    </div>
                                    <div class="smrs-chart-legend__item">
                                        <span class="smrs-chart-legend__swatch smrs-chart-legend__swatch--office"></span>
                                        <span>Office Requests</span>
                                        <strong>@Model.OfficeRequestsInRange (@officeRequestPercent%)</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="smrs-card smrs-card--page smrs-card--tight h-100">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                            <div>
                                <h2 class="h6 text-uppercase text-muted mb-1">RS vs Borrow Requests</h2>
                                <div class="small text-muted">@Model.StartDate.ToString("yyyy-MM-dd") to @Model.EndDate.ToString("yyyy-MM-dd")</div>
                            </div>
                            <span class="badge text-bg-light">Requests</span>
                        </div>

                        @if (maxRequestCount == 0)
                        {
                            <div class="smrs-chart-empty">No RS or borrow request data for this range.</div>
                        }
                        else
                        {
                            <canvas id="requestTypeBarChart"
                                    class="smrs-report-chart smrs-report-chart--bar"
                                    data-rs="@Model.RequisitionsInRange"
                                    data-borrow="@Model.BorrowRequestsInRange"
                                    aria-label="RS requests @Model.RequisitionsInRange, borrow requests @Model.BorrowRequestsInRange">
                            </canvas>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="smrs-section mt-4">
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="smrs-card smrs-card--page smrs-card--tight">
                        <h2 class="h6 text-uppercase text-muted mb-3">Monthly Cost (@DateTime.UtcNow.Year)</h2>
                        <div class="alert alert-info mb-0">Current range cost: <strong>@Model.CostInRange.ToPeso()</strong></div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="smrs-card smrs-card--page smrs-card--tight">
                        <h2 class="h6 text-uppercase text-muted mb-3">Yearly Cost (@Model.CurrentYear)</h2>
                        <div class="alert alert-info mb-0">Approved requisition cost this year: <strong>@Model.CostInCurrentYear.ToPeso()</strong></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="smrs-section mt-4">
            <div class="smrs-card smrs-card--page smrs-card--tight">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="h6 text-uppercase text-muted mb-0">
                        <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color:#dc3545;vertical-align:text-bottom"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        Low Stock Alerts
                        @if (Model.LowStockItems.Count > 0)
                        {
                            <span class="badge text-bg-danger ms-1">@Model.LowStockItems.Count</span>
                        }
                    </h2>
                </div>

                @if (Model.LowStockItems.Count == 0)
                {
                    <div class="alert alert-success mb-0">All items are above their low stock thresholds.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th class="text-end">Available</th>
                                    <th class="text-end">Threshold</th>
                                    <th>Low since</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockItems)
                                {
                                    var isZero = item.AvailableQuantity == 0;
                                    <tr class="@(isZero ? "table-danger" : "table-warning")">
                                        <td>
                                            <a asp-controller="Inventory" asp-action="Index" asp-route-q="@item.ItemName" class="text-decoration-none fw-semibold">
                                                @item.ItemName
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.Brand))
                                            {
                                                <span class="text-muted small">(@item.Brand)</span>
                                            }
                                        </td>
                                        <td>@(item.SupplyGroup == SupplyGroup.ItSupplies ? "IT" : "Office")</td>
                                        <td class="text-end fw-bold @(isZero ? "text-danger" : "")">@item.AvailableQuantity</td>
                                        <td class="text-end text-muted">@item.LowStockLevel</td>
                                        <td>
                                            @if (item.LowStockSince is { } since)
                                            {
                                                <span class="small">@since.LocalDateTime.ToString("yyyy-MM-dd")</span>
                                                <span class="d-block small text-muted">@((int)(DateTimeOffset.UtcNow - since).TotalDays) days ago</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <section class="smrs-section mt-4">
            <div class="smrs-card smrs-card--page smrs-card--tight">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h6 text-uppercase text-muted mb-0">
                            <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color:#fd7e14;vertical-align:text-bottom"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                            No Movement (30+ days)
                            @if (Model.StaleItems.Count > 0)
                            {
                                <span class="badge text-bg-warning text-dark ms-1">@Model.StaleItems.Count</span>
                            }
                        </h2>
                        <div class="small text-muted mt-1">Items with no approved requisitions or borrows in the last 30 days.</div>
                    </div>
                </div>

                @if (Model.StaleItems.Count == 0)
                {
                    <div class="alert alert-success mb-0">All inventory items have had recent activity.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th class="text-end">On hand</th>
                                    <th>Last activity</th>
                                    <th class="text-end">Days idle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.StaleItems)
                                {
                                    var severe = item.DaysSinceActivity >= 90;
                                    <tr class="@(severe ? "table-warning" : "")">
                                        <td>
                                            <a asp-controller="Inventory" asp-action="Index" asp-route-q="@item.ItemName" class="text-decoration-none fw-semibold">
                                                @item.ItemName
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.Brand))
                                            {
                                                <span class="text-muted small">(@item.Brand)</span>
                                            }
                                        </td>
                                        <td>@(item.SupplyGroup == SupplyGroup.ItSupplies ? "IT" : "Office")</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td>
                                            @if (item.LastActivityAt is { } lastAt)
                                            {
                                                <span class="small">@lastAt.LocalDateTime.ToString("yyyy-MM-dd")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No activity recorded</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold @(severe ? "text-danger" : "text-warning")">@item.DaysSinceActivity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="smrs-section mt-4">
            <div class="smrs-card smrs-card--page smrs-card--tight">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h6 text-uppercase text-muted mb-0">
                            <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color:#1a3a5c;vertical-align:text-bottom"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.83V19h2v-4.17l1.59 1.59L16 15.01 12.01 11 8 15.01z"/></svg>
                            Requests Log
                            @if (Model.RequestLog.Count > 0)
                            {
                                <span class="badge text-bg-primary ms-1">@Model.RequestLog.Count</span>
                            }
                        </h2>
                        <div class="small text-muted mt-1">All requisition and borrow requests in the selected range.</div>
                    </div>
                </div>

                @if (Model.RequestLog.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">No requests found in this date range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Ref No.</th>
                                    <th>Requestor</th>
                                    <th>Division</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Items</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model.RequestLog)
                                {
                                    var statusBadge = req.Status switch
                                    {
                                        "InQueue" => "text-bg-info",
                                        "Pending" => "text-bg-warning text-dark",
                                        "Approved" => "text-bg-success",
                                        "Rejected" => "text-bg-danger",
                                        _ => "text-bg-light text-dark border"
                                    };
                                    var statusLabel = req.Status == "InQueue" ? "In Queue" : req.Status;
                                    <tr>
                                        <td><span class="badge text-bg-light text-dark border">@req.RequestType</span></td>
                                        <td class="fw-semibold">@req.ReferenceNo</td>
                                        <td>@req.RequestorName</td>
                                        <td>@req.Division</td>
                                        <td>@req.Date.ToString("yyyy-MM-dd")</td>
                                        <td><span class="badge @statusBadge">@statusLabel</span></td>
                                        <td class="text-end">@req.ItemCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const colors = {
                navy: '#1a3a5c',
                blue: '#2e6da4',
                gold: '#c8a84b',
                muted: '#6c757d',
                grid: 'rgba(26, 58, 92, 0.14)'
            };

            const resizeCanvas = canvas => {
                const dpr = window.devicePixelRatio || 1;
                const rect = canvas.getBoundingClientRect();
                canvas.width = Math.max(1, Math.round(rect.width * dpr));
                canvas.height = Math.max(1, Math.round(rect.height * dpr));

                const ctx = canvas.getContext('2d');
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

                return { ctx, width: rect.width, height: rect.height };
            };

            const drawPieChart = canvas => {
                const it = Number(canvas.dataset.it || 0);
                const office = Number(canvas.dataset.office || 0);
                const total = it + office;
                const { ctx, width, height } = resizeCanvas(canvas);
                const cx = width / 2;
                const cy = height / 2;
                const radius = Math.max(0, Math.min(width, height) * 0.38);
                let startAngle = -Math.PI / 2;

                ctx.clearRect(0, 0, width, height);

                [
                    { value: it, color: colors.blue },
                    { value: office, color: colors.gold }
                ].forEach(slice => {
                    if (slice.value <= 0 || total <= 0) return;

                    const endAngle = startAngle + (slice.value / total) * Math.PI * 2;
                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.arc(cx, cy, radius, startAngle, endAngle);
                    ctx.closePath();
                    ctx.fillStyle = slice.color;
                    ctx.fill();
                    startAngle = endAngle;
                });

                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                ctx.strokeStyle = 'rgba(26, 58, 92, 0.12)';
                ctx.lineWidth = 1;
                ctx.stroke();
            };

            const drawBarChart = canvas => {
                const values = [
                    { label: 'RS', value: Number(canvas.dataset.rs || 0), color: colors.blue },
                    { label: 'Borrow', value: Number(canvas.dataset.borrow || 0), color: colors.gold }
                ];
                const { ctx, width, height } = resizeCanvas(canvas);
                const padding = { top: 24, right: 28, bottom: 42, left: 58 };
                const chartWidth = width - padding.left - padding.right;
                const chartHeight = height - padding.top - padding.bottom;
                const maxValue = Math.max(...values.map(v => v.value), 1);
                const axisMax = Math.max(1, Math.ceil(maxValue / 2) * 2);
                const barWidth = Math.min(70, chartWidth / values.length * 0.45);
                const groupWidth = chartWidth / values.length;

                ctx.clearRect(0, 0, width, height);
                ctx.font = '12px Segoe UI, Arial, sans-serif';
                ctx.textBaseline = 'middle';

                for (let i = 0; i <= 4; i += 1) {
                    const value = axisMax * i / 4;
                    const y = padding.top + chartHeight - (value / axisMax) * chartHeight;

                    ctx.beginPath();
                    ctx.moveTo(padding.left, y);
                    ctx.lineTo(width - padding.right, y);
                    ctx.strokeStyle = colors.grid;
                    ctx.lineWidth = 1;
                    ctx.stroke();

                    ctx.fillStyle = colors.muted;
                    ctx.textAlign = 'right';
                    ctx.fillText(String(Math.round(value)), padding.left - 10, y);
                }

                ctx.beginPath();
                ctx.moveTo(padding.left, padding.top);
                ctx.lineTo(padding.left, padding.top + chartHeight);
                ctx.lineTo(width - padding.right, padding.top + chartHeight);
                ctx.strokeStyle = 'rgba(26, 58, 92, 0.28)';
                ctx.stroke();

                values.forEach((bar, index) => {
                    const x = padding.left + groupWidth * index + (groupWidth - barWidth) / 2;
                    const barHeight = (bar.value / axisMax) * chartHeight;
                    const y = padding.top + chartHeight - barHeight;

                    ctx.fillStyle = bar.color;
                    ctx.fillRect(x, y, barWidth, barHeight);

                    ctx.fillStyle = colors.navy;
                    ctx.textAlign = 'center';
                    ctx.font = '700 12px Segoe UI, Arial, sans-serif';
                    ctx.fillText(String(bar.value), x + barWidth / 2, Math.max(12, y - 10));

                    ctx.font = '600 12px Segoe UI, Arial, sans-serif';
                    ctx.fillText(bar.label, x + barWidth / 2, padding.top + chartHeight + 24);
                });
            };

            const renderCharts = () => {
                const pieChart = document.getElementById('requestsPieChart');
                const barChart = document.getElementById('requestTypeBarChart');

                if (pieChart) drawPieChart(pieChart);
                if (barChart) drawBarChart(barChart);
            };

            renderCharts();
            window.addEventListener('resize', renderCharts);
        })();
    </script>
}
