@using PICTO.SMRS.Web.Models.Borrow
@using PICTO.SMRS.Web.Services
@model IReadOnlyList<BorrowIndexRowViewModel>
@{
    ViewData["Title"] = "Borrow";
}
@inject PICTO.SMRS.Web.Data.ApplicationDbContext Db

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <h1 class="h3 text-navy mb-1">Borrow</h1>
            </div>
            <a asp-action="Create" class="btn btn-gold text-navy fw-semibold">New borrower&rsquo;s slip</a>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }

        <section class="smrs-section mt-4">
            <h2 class="h6 text-uppercase text-muted mb-3">My borrow requests</h2>
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">You have no submitted borrow requests yet.</div>
            }
            else
            {
                var queuePositions = await QueuePositionHelper.GetBorrowQueuePositionsAsync(Db);
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RF No.</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th>Issued</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var statusDisplay = QueuePositionHelper.FormatBorrowLifecycleStatus(
                                    row.Status, queuePositions.GetValueOrDefault(row.Id), row.IssuedAt, row.MarkedReturnedAt, row.ReturnConfirmedAt);
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@row.Id" class="text-decoration-none fw-semibold">@(string.IsNullOrWhiteSpace(row.RfNo) ? "—" : row.RfNo)</a>
                                    </td>
                                    <td>@row.SlipDate.ToString("yyyy-MM-dd")</td>
                                    <td>@row.ItemCount</td>
                                    <td>@statusDisplay</td>
                                    <td>
                                        @if (row.IssuedAt is { } issuedAt)
                                        {
                                            <span class="badge text-bg-light text-dark border">Issued</span>
                                            <span class="d-block small text-muted">@issuedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (row.Status == BorrowStatus.InQueue)
                                        {
                                            <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                                        }
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
