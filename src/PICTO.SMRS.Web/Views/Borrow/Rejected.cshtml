@using PICTO.SMRS.Web.Models.Borrow
@model IReadOnlyList<BorrowApprovalRowViewModel>
@{
    ViewData["Title"] = "Rejected Borrow Requests";
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Rejected Borrow Requests</h1>
            <p class="text-muted small mb-0">All borrow requests that have been rejected.</p>
        </header>

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No rejected borrow requests.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RF No.</th>
                                <th>Date</th>
                                <th>Borrower</th>
                                <th>Division</th>
                                <th>Items</th>
                                <th>Reason</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(row.RfNo) ? "—" : row.RfNo)</td>
                                    <td>@row.SlipDate.ToString("yyyy-MM-dd")</td>
                                    <td>@row.BorrowerName</td>
                                    <td>@row.BorrowerDivision</td>
                                    <td>@row.ItemCount</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.RejectionReason))
                                        {
                                            <span class="text-danger small">@row.RejectionReason</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
