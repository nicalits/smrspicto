@using PICTO.SMRS.Web.Models.Borrow
@model IReadOnlyList<BorrowApprovalRowViewModel>
@{
    ViewData["Title"] = "Borrow Approvals";
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Borrow Approvals</h1>
            
        </header>

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No borrow requests available.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RF No.</th>
                                <th>Date</th>
                                <th>Borrower</th>
                                <th>Division</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th>Issued</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var badgeClass = row.Status switch
                                {
                                    BorrowStatus.Approved => "bg-success",
                                    BorrowStatus.Rejected => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(row.RfNo) ? "—" : row.RfNo)</td>
                                    <td>@row.SlipDate.ToString("yyyy-MM-dd")</td>
                                    <td>@row.BorrowerName</td>
                                    <td>@row.BorrowerDivision</td>
                                    <td>@row.ItemCount</td>
                                    <td><span class="badge @badgeClass">@row.Status</span></td>
                                    <td>
                                        @if (row.IssuedAt is { } issuedAt)
                                        {
                                            <span class="badge bg-primary">Issued</span>
                                            <span class="d-block small text-muted">@issuedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
