@using PICTO.SMRS.Web.Models.Borrow
@using PICTO.SMRS.Web.Services
@model IReadOnlyList<BorrowApprovalRowViewModel>
@{
    ViewData["Title"] = "Borrow Approvals";
    var queuePositions = ViewData["QueuePositions"] as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Borrow Approvals</h1>
            <p class="text-muted small mb-0">Queued and on-hold borrow requests awaiting action.</p>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">@err</div>
        }

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No borrow requests awaiting action.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RF No.</th>
                                <th>Date</th>
                                <th>Borrower</th>
                                <th>Division</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var statusDisplay = QueuePositionHelper.FormatQueueStatus(row.Status, queuePositions.GetValueOrDefault(row.Id));
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(row.RfNo) ? "—" : row.RfNo)</td>
                                    <td>@row.SlipDate.ToString("yyyy-MM-dd")</td>
                                    <td>@row.BorrowerName</td>
                                    <td>@row.BorrowerDivision</td>
                                    <td>@row.ItemCount</td>
                                    <td>
                                        @statusDisplay
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
