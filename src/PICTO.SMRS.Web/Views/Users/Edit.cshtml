@model EditUserViewModel
@{
    ViewData["Title"] = "Edit account";
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page mx-auto" style="max-width: 520px;">
        <header class="mb-4">
            <h1 class="h3 text-navy mb-1">Edit account</h1>
            <p class="text-muted small mb-0">Update profile, role, or set a new password.</p>
        </header>

        <form asp-action="Edit" method="post" novalidate
              onsubmit="return confirm('Save changes to this account?');">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EmployeeName" class="form-label"></label>
                <input asp-for="EmployeeName" class="form-control" autocomplete="name" />
                <span asp-validation-for="EmployeeName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Position" class="form-label"></label>
                <input asp-for="Position" class="form-control" autocomplete="organization-title" />
                <span asp-validation-for="Position" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Division" class="form-label"></label>
                <input asp-for="Division" class="form-control" autocomplete="organization" />
                <span asp-validation-for="Division" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select"></select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">Leave blank to keep the current password.</div>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-gold text-navy fw-semibold">Save changes</button>
                <a href="@($"{Url.Action("Create", "Users")}#accounts")" class="btn btn-outline-secondary">Back to user accounts</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
