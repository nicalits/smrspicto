@using PICTO.SMRS.Web.Models.Requisitions
@using PICTO.SMRS.Web.Services
@model RequisitionDetailsViewModel
@{
    var rsNo = string.IsNullOrWhiteSpace(Model.RsNo) ? $"#{Model.Id}" : Model.RsNo;
    ViewData["Title"] = $"Requisition {rsNo}";
    var canTakeAction = (bool?)ViewData["CanTakeAction"] == true;
    var canCancelApproval = (bool?)ViewData["CanCancelApproval"] == true;
    var canEdit = (bool?)ViewData["CanEdit"] == true;
    var canMarkReceived = (bool?)ViewData["CanMarkReceived"] == true;
    var backAction = ViewData["BackAction"]?.ToString() ?? "Index";
    var queuePositions = ViewData["QueuePositions"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var statusDisplay = QueuePositionHelper.FormatQueueStatus(Model.Status, queuePositions.GetValueOrDefault(Model.Id));
    var badgeClass = Model.Status switch
    {
        RequisitionStatus.InQueue => "text-bg-info",
        RequisitionStatus.Pending => "text-bg-warning text-dark",
        RequisitionStatus.Approved => "text-bg-success",
        RequisitionStatus.Rejected => "text-bg-danger",
        _ => "text-bg-light text-dark border"
    };
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1 class="h3 text-navy mb-1">Requisition @rsNo</h1>
                <p class="text-muted small mb-0">Submitted request details and approval status.</p>
            </div>
            <span class="badge @badgeClass fs-6">@statusDisplay</span>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">@err</div>
        }

        @if (Model.Status == RequisitionStatus.Pending && !string.IsNullOrWhiteSpace(Model.PendingReason))
        {
            <div class="alert alert-warning mt-4 mb-0" role="alert">
                <strong>On hold:</strong> @Model.PendingReason
            </div>
        }

        @if (Model.Status == RequisitionStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">
                <strong>Rejection reason:</strong> @Model.RejectionReason
            </div>
        }

        <section class="smrs-section mt-4">
            <div class="row g-3 small">
                <div class="col-md-3"><span class="text-muted d-block">Date</span><span class="fw-semibold">@Model.Date.ToString("yyyy-MM-dd")</span></div>
                <div class="col-md-3"><span class="text-muted d-block">Type</span><span class="fw-semibold">@(Model.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</span></div>
                <div class="col-md-3"><span class="text-muted d-block">Requestor</span><span class="fw-semibold">@Model.RequestorName</span></div>
                <div class="col-md-3"><span class="text-muted d-block">Division</span><span class="fw-semibold">@Model.RequestorDivision</span></div>
                @if (Model.Status == RequisitionStatus.Approved)
                {
                    <div class="col-md-3">
                        <span class="text-muted d-block">Under use</span>
                        @if (Model.MarkedInUseAt is { } atUse)
                        {
                            <span class="badge text-bg-light text-dark border">In use</span>
                            <span class="d-block fw-semibold mt-1">@atUse.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light text-dark border">Awaiting issuance</span>
                        }
                    </div>
                    @if (Model.ReceivedAt is { } atReceived)
                    {
                        <div class="col-md-3">
                            <span class="text-muted d-block">Received</span>
                            <span class="badge text-bg-success">Received</span>
                            <span class="d-block fw-semibold mt-1">@atReceived.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="smrs-section mt-3">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Name</th>
                            <th>Serial No.</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Purpose</th>
                            <th>RF No.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ItemName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.SerialNo) ? "—" : item.SerialNo)</td>
                                <td>@item.Qty</td>
                                <td>@item.Unit</td>
                                <td>@item.Purpose</td>
                                <td>@(string.IsNullOrWhiteSpace(item.RfNo) ? "—" : item.RfNo)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="smrs-section mt-3">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="@backAction" class="btn btn-outline-secondary">Back</a>
                @if (canEdit)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark">Edit</a>
                }
                @if (canTakeAction)
                {
                    <form asp-action="Approve" method="post" class="d-inline"
                          onsubmit="return confirm('Approve this requisition?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-dark">Approve</button>
                    </form>
                    <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject</button>
                    @if (Model.Status == RequisitionStatus.InQueue)
                    {
                        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#holdModal">Hold</button>
                    }
                }
                @if (canCancelApproval)
                {
                    <form asp-action="CancelApproval" method="post" class="d-inline"
                          onsubmit="return confirm('Cancel this approval? The requisition will return to the queue.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-dark">Cancel approval</button>
                    </form>
                }
                @if (canMarkReceived)
                {
                    <form asp-action="MarkReceived" method="post" class="d-inline"
                          onsubmit="return confirm('Confirm you have received the items?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">Mark as received</button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@if (canTakeAction)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="rejectModalLabel">Reject Requisition</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="rejectReason" class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                            <textarea id="rejectReason" name="reason" class="form-control" rows="3" required maxlength="500" placeholder="Please provide a reason..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Status == RequisitionStatus.InQueue)
    {
        <div class="modal fade" id="holdModal" tabindex="-1" aria-labelledby="holdModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Hold" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="holdModalLabel">Put on Hold</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="holdReason" class="form-label">Reason for hold <span class="text-danger">*</span></label>
                                <textarea id="holdReason" name="reason" class="form-control" rows="3" required maxlength="500" placeholder="Please provide a reason..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning">Put on Hold</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
