@using PICTO.SMRS.Web.Models.Requisitions
@model IReadOnlyList<RequisitionApprovalRowViewModel>
@{
    ViewData["Title"] = "Rejected Requisitions";
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Rejected Requisitions</h1>
            <p class="text-muted small mb-0">All requisitions that have been rejected.</p>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No rejected requisitions.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RS No.</th>
                                <th>Date</th>
                                <th>Requestor</th>
                                <th>Division</th>
                                <th>Type</th>
                                <th>Items</th>
                                <th>Reason</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(row.RsNo) ? "—" : row.RsNo)</td>
                                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@row.RequestorName</td>
                                    <td>@row.RequestorDivision</td>
                                    <td>@(row.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</td>
                                    <td>@row.ItemCount</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.RejectionReason))
                                        {
                                            <span class="text-danger small">@row.RejectionReason</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
