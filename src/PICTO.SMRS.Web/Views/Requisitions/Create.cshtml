@using PICTO.SMRS.Web.Models.Requisitions
@using PICTO.SMRS.Web.Models.Inventory
@model RequisitionCreateViewModel
@{
    var formAction = ViewData["FormAction"]?.ToString() ?? "Create";
    var submitLabel = ViewData["SubmitLabel"]?.ToString() ?? "Submit";
    var pageHeading = ViewData["PageHeading"]?.ToString() ?? "New requisition slip";
    var editId = ViewData["EditId"] as int?;
    ViewData["Title"] = pageHeading;
}

<div class="smrs-page smrs-page--wide">
    <div class="smrs-card smrs-card--page smrs-card--tight">
        <section class="smrs-section">
            <form asp-action="@formAction" method="post" id="rqForm" novalidate>
                @Html.AntiForgeryToken()
                @if (editId is int id)
                {
                    <input type="hidden" name="id" value="@id" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div>
                    <table class="table table-bordered align-middle mb-2 smrs-slip-table">
                        <tbody>
                            <tr>
                                <td colspan="6" class="bg-light text-center">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                        <div class="fw-semibold text-navy flex-grow-1 text-center">@pageHeading</div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <label asp-for="RsNo" class="small fw-semibold text-muted mb-0"></label>
                                                <input asp-for="RsNo" class="form-control form-control-sm" placeholder="00-0000" maxlength="7" inputmode="numeric" style="width: 120px;" />
                                            </div>
                                            <select asp-for="ItemType" class="form-select form-select-sm" style="min-width: 210px;">
                                                <option value="@RequisitionItemType.ItSupplies">IT Supplies</option>
                                                <option value="@RequisitionItemType.OfficeSupplies">Office Supplies</option>
                                            </select>
                                        </div>
                                    </div>
                                    <span asp-validation-for="RsNo" class="text-danger small d-block mt-1 text-end"></span>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="6" class="bg-light fw-semibold text-navy text-center">Requestor's information</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="small text-muted">Date</div>
                                    <input class="form-control form-control-sm" value="@Model.Date.ToString("yyyy-MM-dd")" readonly />
                                </td>
                                <td>
                                    <div class="small text-muted">Name</div>
                                    <input class="form-control form-control-sm" value="@Model.RequestorName" readonly />
                                </td>
                                <td>
                                    <div class="small text-muted">Position</div>
                                    <input class="form-control form-control-sm" value="@Model.RequestorPosition" readonly />
                                </td>
                                <td>
                                    <div class="small text-muted">Division</div>
                                    <input class="form-control form-control-sm" value="@Model.RequestorDivision" readonly />
                                </td>
                                <td colspan="2">
                                    <div class="small text-muted">Signature</div>
                                    <input class="form-control form-control-sm" value="" readonly />
                                </td>
                            </tr>

                            <tr>
                                <td colspan="6" class="bg-light fw-semibold text-navy text-center">Request Information</td>
                            </tr>
                            <tr class="bg-light text-center">
                                <td class="fw-semibold" style="width: 26%;">Item Name</td>
                                <td class="fw-semibold" style="width: 16%;">Serial No.</td>
                                <td class="fw-semibold" style="width: 8%;">Qty</td>
                                <td class="fw-semibold" style="width: 10%;">Unit</td>
                                <td class="fw-semibold" style="width: 25%;">Purpose</td>
                                <td class="fw-semibold" style="width: 15%;">RF No.</td>
                            </tr>
                        </tbody>
                        <tbody id="rqItemsBody">
                            @for (var i = 0; i < (Model.Items?.Count ?? 0); i++)
                            {
                                <tr class="rq-item-row">
                                    <td>
                                        <input asp-for="Items[i].InventoryItemId" type="hidden" class="rq-item-id" />
                                        <div class="d-flex gap-2 mb-1">
                                            <input class="form-control form-control-sm rq-item-summary" value="" placeholder="No item selected" readonly />
                                            <button type="button" class="btn btn-sm btn-outline-secondary rq-open-item-picker text-nowrap">Select item</button>
                                        </div>
                                        <span asp-validation-for="Items[i].InventoryItemId" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].SerialNo" class="form-control form-control-sm rq-serial" readonly />
                                        <span asp-validation-for="Items[i].SerialNo" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Qty" class="form-control form-control-sm rq-qty" type="number" min="1" />
                                        <span asp-validation-for="Items[i].Qty" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <select asp-for="Items[i].Unit" class="form-select form-select-sm rq-unit-select">
                                            <option value="">Select unit…</option>
                                            @foreach (var unit in Enum.GetValues<InventoryUnit>())
                                            {
                                                <option value="@unit.GetDisplayName()">@unit.GetDisplayName()</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Items[i].Unit" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Purpose" class="form-control form-control-sm" />
                                        <span asp-validation-for="Items[i].Purpose" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input asp-for="Items[i].RfNo" class="form-control form-control-sm" placeholder="00-0000" maxlength="7" inputmode="numeric" style="width: 120px;" />
                                            <button type="button" class="btn btn-sm btn-outline-danger rq-remove-row text-nowrap px-2" title="Remove row">Remove</button>
                                        </div>
                                        <span asp-validation-for="Items[i].RfNo" class="text-danger small"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tbody>
                            <tr>
                                <td colspan="6">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="rqAddRow">Add row</button>
                                        <span asp-validation-for="Items" class="text-danger small"></span>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <div class="small text-muted">MR/ICS To:</div>
                                    <input class="form-control form-control-sm" value="" />
                                </td>
                                <td colspan="3">
                                    <label asp-for="Office" class="form-label small text-muted mb-1"></label>
                                    <input asp-for="Office" class="form-control form-control-sm" />
                                    <span asp-validation-for="Office" class="text-danger small"></span>
                                </td>
                                <td colspan="2">
                                    <label asp-for="MrIcsPosition" class="form-label small text-muted mb-1"></label>
                                    <input asp-for="MrIcsPosition" class="form-control form-control-sm" />
                                    <span asp-validation-for="MrIcsPosition" class="text-danger small"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top border-light-subtle">
                    <button type="submit" class="btn btn-gold text-navy fw-semibold px-4">@submitLabel</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </section>
    </div>
</div>

<div id="rqItemPickerModal" class="position-fixed top-0 start-0 w-100 h-100 d-none" style="background: rgba(0,0,0,.35); z-index: 1080;">
    <div class="position-absolute top-50 start-50 translate-middle bg-white rounded shadow p-3" style="width: min(980px, 95vw); max-height: 85vh; overflow: auto;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 text-navy">Select item</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="rqItemPickerClose">Close</button>
        </div>
        <input id="rqItemPickerSearch" type="search" class="form-control form-control-sm mb-2" placeholder="Search item, brand, specification, or unit..." />
        <div class="table-responsive border rounded">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 23%;">Item</th>
                        <th style="width: 17%;">Brand</th>
                        <th style="width: 30%;">Specification</th>
                        <th style="width: 10%;">Unit</th>
                        <th style="width: 10%;">Serialized</th>
                        <th style="width: 10%;"></th>
                    </tr>
                </thead>
                <tbody id="rqItemPickerBody">
                    <tr><td colspan="6" class="text-muted small">No items found.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('rqForm');
            var body = document.getElementById('rqItemsBody');
            var addBtn = document.getElementById('rqAddRow');
            if (!body || !addBtn) return;

            function renumber() {
                var rows = body.querySelectorAll('tr.rq-item-row');
                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i];
                    var inputs = row.querySelectorAll('input[name], select[name]');
                    inputs.forEach(function (inp) {
                        var name = inp.getAttribute('name');
                        if (!name) return;
                        inp.setAttribute('name', name.replace(/Items\[\d+\]/g, 'Items[' + i + ']'));
                        var id = inp.getAttribute('id');
                        if (id) inp.setAttribute('id', id.replace(/Items_\d+__/g, 'Items_' + i + '__'));
                    });

                    var spans = row.querySelectorAll('span[data-valmsg-for]');
                    spans.forEach(function (sp) {
                        var f = sp.getAttribute('data-valmsg-for');
                        if (!f) return;
                        sp.setAttribute('data-valmsg-for', f.replace(/Items\[\d+\]/g, 'Items[' + i + ']'));
                    });
                }
            }

            var itemsCache = { type: null, items: [] };
            var serialsCache = {};

            function getTypeSelect() {
                return document.querySelector('select[name="ItemType"]');
            }

            async function loadItemsForType(typeVal) {
                if (itemsCache.type === typeVal && itemsCache.items.length)
                    return itemsCache.items;

                itemsCache.type = typeVal;
                itemsCache.items = [];
                try {
                    var res = await fetch('@Url.Action("InventoryItems")' + '?type=' + encodeURIComponent(typeVal), {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return [];
                    itemsCache.items = await res.json();
                } catch (e) {
                    itemsCache.items = [];
                }
                return itemsCache.items;
            }

            function specificationLabel(item) {
                var spec = (item.specification || '').trim();
                if (spec) return spec;
                return 'Standard configuration';
            }

            function setItemId(row, idValue) {
                var hidden = row.querySelector('.rq-item-id');
                if (hidden) hidden.value = idValue || '0';
            }

            function getItemById(items, idValue) {
                var idNum = parseInt(idValue || '0', 10);
                if (!idNum) return null;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].id === idNum) return items[i];
                }
                return null;
            }

            function itemSummary(item) {
                if (!item) return '';
                return [item.name, item.brand, specificationLabel(item)].filter(function (part) {
                    return !!(part && String(part).trim());
                }).join(' - ');
            }

            function availableLabel(item) {
                if (!item) return '';
                var available = Number(item.availableQuantity || 0);
                return available + ' available';
            }

            function syncRowSummary(row, items) {
                var summary = row.querySelector('.rq-item-summary');
                var hidden = row.querySelector('.rq-item-id');
                if (!summary || !hidden) return;
                var selectedItem = getItemById(items, hidden.value);
                summary.value = selectedItem ? itemSummary(selectedItem) + ' (' + availableLabel(selectedItem) + ')' : '';
            }

            async function syncAllSelects() {
                var typeSel = getTypeSelect();
                var typeVal = typeSel ? typeSel.value : '';
                var items = await loadItemsForType(typeVal);
                body.querySelectorAll('tr.rq-item-row').forEach(function (row) {
                    syncRowSummary(row, items);
                    syncQuantityLimit(row);
                });
                validateQuantities();
                renderPickerRows(items);
            }

            function syncQuantityLimit(row) {
                var itemIdInput = row.querySelector('.rq-item-id');
                var qty = row.querySelector('.rq-qty');
                if (!itemIdInput || !qty) return;

                var selectedItem = getItemById(itemsCache.items, itemIdInput.value);
                if (!selectedItem) {
                    qty.removeAttribute('max');
                    qty.setCustomValidity('');
                    return;
                }

                var available = Math.max(0, Number(selectedItem.availableQuantity || 0));
                qty.max = String(available);
                qty.title = 'Available quantity: ' + available;
                clampRowQuantity(row);
            }

            function clampRowQuantity(row) {
                var qty = row.querySelector('.rq-qty');
                if (!qty || !qty.max) return;

                var max = Number(qty.max || 0);
                var requested = Number(qty.value || 0);
                if (requested > max) {
                    qty.value = String(max);
                }
            }

            function validateQuantities() {
                var requestedByItem = {};
                body.querySelectorAll('tr.rq-item-row').forEach(function (row) {
                    var idInput = row.querySelector('.rq-item-id');
                    var qtyInput = row.querySelector('.rq-qty');
                    if (!idInput || !qtyInput) return;
                    qtyInput.setCustomValidity('');

                    var itemId = idInput.value || '0';
                    var selectedItem = getItemById(itemsCache.items, itemId);
                    if (!selectedItem) return;

                    var qty = Number(qtyInput.value || 0);
                    requestedByItem[itemId] = (requestedByItem[itemId] || 0) + qty;
                });

                body.querySelectorAll('tr.rq-item-row').forEach(function (row) {
                    var idInput = row.querySelector('.rq-item-id');
                    var qtyInput = row.querySelector('.rq-qty');
                    if (!idInput || !qtyInput) return;

                    var selectedItem = getItemById(itemsCache.items, idInput.value || '0');
                    if (!selectedItem) return;

                    var available = Math.max(0, Number(selectedItem.availableQuantity || 0));
                    var requested = requestedByItem[idInput.value || '0'] || 0;
                    if (requested > available) {
                        qtyInput.setCustomValidity('Only ' + available + ' available for ' + selectedItem.name + '.');
                    }
                });
            }

            async function loadSerialsForItem(itemId) {
                if (serialsCache[itemId]) return serialsCache[itemId];

                try {
                    var res = await fetch('@Url.Action("InventoryItemSerials")' + '?id=' + encodeURIComponent(itemId), {
                        headers: { 'Accept': 'application/json' }
                    });
                    serialsCache[itemId] = res.ok ? await res.json() : [];
                } catch (e) {
                    serialsCache[itemId] = [];
                }

                return serialsCache[itemId];
            }

            async function syncSerializedSerialsForItem(itemId) {
                var serials = await loadSerialsForItem(itemId);
                var offset = 0;
                body.querySelectorAll('tr.rq-item-row').forEach(function (row) {
                    var itemIdInput = row.querySelector('.rq-item-id');
                    var serial = row.querySelector('.rq-serial');
                    var qty = row.querySelector('.rq-qty');
                    if (!itemIdInput || !serial || !qty || itemIdInput.value !== String(itemId)) return;

                    var requested = Math.max(0, Number(qty.value || 0));
                    serial.value = serials.slice(offset, offset + requested).join(', ');
                    offset += requested;
                });
            }

            async function syncSerialAndUnit(row) {
                var itemIdInput = row.querySelector('.rq-item-id');
                var serial = row.querySelector('.rq-serial');
                var unit = row.querySelector('.rq-unit-select');
                if (!itemIdInput || !serial) return;

                var selectedItem = getItemById(itemsCache.items, itemIdInput.value);
                var serialized = !!selectedItem && !!selectedItem.isSerialized;
                serial.readOnly = true;

                if (unit) {
                    var itemUnit = selectedItem ? (selectedItem.unit || '') : '';
                    if (itemUnit) unit.value = itemUnit;
                }

                if (!serialized || !selectedItem) {
                    serial.value = '';
                    return;
                }

                await syncSerializedSerialsForItem(itemIdInput.value);
            }

            function makeRow() {
                var tr = document.createElement('tr');
                tr.className = 'rq-item-row';
                tr.innerHTML =
                    '<td><input type="hidden" class="rq-item-id" name="Items[0].InventoryItemId" value="0" /><div class="d-flex gap-2 mb-1"><input class="form-control form-control-sm rq-item-summary" placeholder="No item selected" readonly /><button type="button" class="btn btn-sm btn-outline-secondary rq-open-item-picker text-nowrap">Select item</button></div><span class="text-danger small" data-valmsg-for="Items[0].InventoryItemId" data-valmsg-replace="true"></span></td>' +
                    '<td><input class="form-control form-control-sm rq-serial" name="Items[0].SerialNo" readonly /><span class="text-danger small" data-valmsg-for="Items[0].SerialNo" data-valmsg-replace="true"></span></td>' +
                    '<td><input class="form-control form-control-sm rq-qty" type="number" min="1" value="1" name="Items[0].Qty" /><span class="text-danger small" data-valmsg-for="Items[0].Qty" data-valmsg-replace="true"></span></td>' +
                    '<td><select class="form-select form-select-sm rq-unit-select" name="Items[0].Unit"><option value="">Select unit…</option>@foreach (var unit in Enum.GetValues<InventoryUnit>()) {<option value="@unit.GetDisplayName()">@unit.GetDisplayName()</option>}</select><span class="text-danger small" data-valmsg-for="Items[0].Unit" data-valmsg-replace="true"></span></td>' +
                    '<td><input class="form-control form-control-sm" name="Items[0].Purpose" /><span class="text-danger small" data-valmsg-for="Items[0].Purpose" data-valmsg-replace="true"></span></td>' +
                    '<td><div class="d-flex gap-2"><input class="form-control form-control-sm" name="Items[0].RfNo" placeholder="00-0000" maxlength="7" inputmode="numeric" style="width: 120px;" /><button type="button" class="btn btn-sm btn-outline-danger rq-remove-row text-nowrap px-2" title="Remove row">Remove</button></div><span class="text-danger small" data-valmsg-for="Items[0].RfNo" data-valmsg-replace="true"></span></td>';
                return tr;
            }

            var modal = document.getElementById('rqItemPickerModal');
            var modalBody = document.getElementById('rqItemPickerBody');
            var modalSearch = document.getElementById('rqItemPickerSearch');
            var modalClose = document.getElementById('rqItemPickerClose');
            var activeRow = null;

            function renderPickerRows(items) {
                if (!modalBody) return;
                var keyword = (modalSearch && modalSearch.value ? modalSearch.value : '').trim().toLowerCase();
                var filtered = items.filter(function (it) {
                    if (!keyword) return true;
                    var haystack = [
                        it.name || '',
                        it.brand || '',
                        specificationLabel(it),
                        it.unit || '',
                        it.isSerialized ? 'serialized yes' : 'not serialized no'
                    ].join(' ').toLowerCase();
                    return haystack.indexOf(keyword) !== -1;
                });

                if (filtered.length === 0) {
                    modalBody.innerHTML = '<tr><td colspan="6" class="text-muted small">No items found.</td></tr>';
                    return;
                }

                modalBody.innerHTML = filtered.map(function (it) {
                    return '<tr>' +
                        '<td>' + (it.name || '') + '</td>' +
                        '<td>' + ((it.brand || '').trim() || 'Unbranded') + '</td>' +
                        '<td>' + specificationLabel(it) + '</td>' +
                        '<td>' + (it.unit || '') + '<div class="text-muted small">' + availableLabel(it) + '</div></td>' +
                        '<td>' + (it.isSerialized ? 'Yes' : 'No') + '</td>' +
                        '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary rq-picker-select" data-id="' + it.id + '"' + (Number(it.availableQuantity || 0) <= 0 ? ' disabled' : '') + '>Choose</button></td>' +
                        '</tr>';
                }).join('');
            }

            function openPicker(row) {
                activeRow = row;
                if (modalSearch) modalSearch.value = '';
                renderPickerRows(itemsCache.items);
                if (modal) modal.classList.remove('d-none');
                if (modalSearch) modalSearch.focus();
            }

            function closePicker() {
                activeRow = null;
                if (modal) modal.classList.add('d-none');
            }

            addBtn.addEventListener('click', function () {
                body.appendChild(makeRow());
                renumber();
                syncAllSelects();
            });

            document.addEventListener('change', function (e) {
                var typeSel = e.target.closest('select[name="ItemType"]');
                if (typeSel) {
                    itemsCache.type = null;
                    itemsCache.items = [];
                    syncAllSelects();
                    return;
                }

                var row = e.target.closest('tr.rq-item-row');
                if (!row) return;
            });

            body.addEventListener('click', function (e) {
                var pickerBtn = e.target.closest('.rq-open-item-picker');
                if (pickerBtn) {
                    var row = pickerBtn.closest('tr.rq-item-row');
                    if (!row) return;
                    openPicker(row);
                    return;
                }

                var btn = e.target.closest('.rq-remove-row');
                if (!btn) return;
                var tr = btn.closest('tr');
                if (!tr) return;
                tr.remove();
                if (body.querySelectorAll('tr.rq-item-row').length === 0) {
                    body.appendChild(makeRow());
                }
                renumber();
                syncAllSelects();
            });

            if (modalSearch) {
                modalSearch.addEventListener('input', function () {
                    renderPickerRows(itemsCache.items);
                });
            }

            if (modalClose) {
                modalClose.addEventListener('click', closePicker);
            }

            if (modalBody) {
                modalBody.addEventListener('click', function (e) {
                    var chooseBtn = e.target.closest('.rq-picker-select');
                    if (!chooseBtn || !activeRow) return;
                    var selectedId = chooseBtn.getAttribute('data-id') || '0';
                    setItemId(activeRow, selectedId);
                    syncRowSummary(activeRow, itemsCache.items);
                    syncQuantityLimit(activeRow);
                    validateQuantities();
                    syncSerialAndUnit(activeRow);
                    closePicker();
                });
            }

            body.addEventListener('input', function (e) {
                if (e.target.closest('.rq-qty')) {
                    var row = e.target.closest('tr.rq-item-row');
                    if (row) clampRowQuantity(row);
                    validateQuantities();
                    if (row) syncSerialAndUnit(row);
                }
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    validateQuantities();
                    if (!form.checkValidity()) {
                        e.preventDefault();
                        form.reportValidity();
                    }
                });
            }

            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) closePicker();
                });
            }

            syncAllSelects().then(function () {
                body.querySelectorAll('tr.rq-item-row').forEach(function (r) {
                    syncSerialAndUnit(r);
                });
            });
        })();
    </script>
}

