@using PICTO.SMRS.Web.Models.Requisitions
@using PICTO.SMRS.Web.Services
@model IReadOnlyList<RequisitionIndexRowViewModel>
@{
    ViewData["Title"] = "Requisitions";
}
@inject PICTO.SMRS.Web.Data.ApplicationDbContext Db

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
            <h1 class="h3 text-navy mb-1">Requisitions</h1>
            <a asp-action="Create" class="btn btn-gold text-navy fw-semibold">New requisition slip</a>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }

        <section class="smrs-section mt-4">
            <h2 class="h6 text-uppercase text-muted mb-3">My Request Status</h2>
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">You have no submitted requisitions yet.</div>
            }
            else
            {
                var queuePositions = await QueuePositionHelper.GetRequisitionQueuePositionsAsync(Db);
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>RS No.</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th>Issuance</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var statusDisplay = QueuePositionHelper.FormatQueueStatus(row.Status, queuePositions.GetValueOrDefault(row.Id));
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@row.Id" class="text-decoration-none fw-semibold">@(string.IsNullOrWhiteSpace(row.RsNo) ? "—" : row.RsNo)</a>
                                    </td>
                                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@(row.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</td>
                                    <td>@row.ItemCount</td>
                                    <td>@statusDisplay</td>
                                    <td>
                                        @if (row.Status == RequisitionStatus.Approved)
                                        {
                                            if (row.ReceivedAt is not null)
                                            {
                                                <span class="badge text-bg-success">Received</span>
                                            }
                                            else if (row.MarkedInUseAt is not null)
                                            {
                                                <span class="badge text-bg-light text-dark border">Pending receipt</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-light text-dark border">Awaiting issuance</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (row.Status == RequisitionStatus.InQueue)
                                        {
                                            <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                                        }
                                        @if (row.Status == RequisitionStatus.Approved
                                            && row.MarkedInUseAt is not null
                                            && row.ReceivedAt is null)
                                        {
                                            <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
