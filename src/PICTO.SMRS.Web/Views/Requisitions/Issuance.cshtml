@using PICTO.SMRS.Web.Models.Requisitions

@model IReadOnlyList<RequisitionApprovalRowViewModel>

@{

    ViewData["Title"] = "Issuance";

    var canIssue = (bool?)ViewData["CanIssue"] == true;

}



<div class="smrs-page">

    <div class="smrs-card smrs-card--page">

        <header class="smrs-page-header">

            <h1 class="h3 text-navy mb-1">Issuance</h1>

            <p class="text-muted small mb-0">Record physical issuance for approved requisitions. After issuance, the requestor confirms receipt on their requisitions list.</p>

        </header>



        <section class="smrs-section mt-4">

            @if (Model.Count == 0)

            {

                <div class="alert alert-secondary mb-0">No requisitions awaiting issuance.</div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-sm align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>RS No.</th>

                                <th>Date</th>

                                <th>Requestor</th>

                                <th>Division</th>

                                <th>Type</th>

                                <th>Items</th>

                                <th class="text-end">Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var row in Model)

                            {

                                <tr>

                                    <td>@(string.IsNullOrWhiteSpace(row.RsNo) ? "—" : row.RsNo)</td>

                                    <td>@row.Date.ToString("yyyy-MM-dd")</td>

                                    <td>@row.RequestorName</td>

                                    <td>@row.RequestorDivision</td>

                                    <td>@(row.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</td>

                                    <td>@row.ItemCount</td>

                                    <td class="text-end">

                                        <div class="d-inline-flex flex-wrap gap-1 justify-content-end">

                                            <a asp-action="Details" asp-route-id="@row.Id" asp-route-returnAction="Issuance" class="btn btn-sm btn-outline-dark">View</a>

                                            @if (canIssue)

                                            {

                                                <form asp-action="MarkInUse" method="post" class="d-inline"

                                                      onsubmit="return confirm('Record issuance for this requisition? Items will be issued to the requestor.');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@row.Id" />

                                                    <input type="hidden" name="returnAction" value="Issuance" />

                                                    <button type="submit" class="btn btn-sm btn-dark">Record issuance</button>

                                                </form>

                                            }

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </section>

    </div>

</div>

