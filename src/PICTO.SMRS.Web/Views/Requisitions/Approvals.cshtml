@using PICTO.SMRS.Web.Models.Requisitions
@using PICTO.SMRS.Web.Services
@model IReadOnlyList<RequisitionApprovalRowViewModel>
@{
    ViewData["Title"] = "Requisition Approvals";
    var canApprove = (bool?)ViewData["CanApprove"] == true;
    var queuePositions = ViewData["QueuePositions"] as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Requisition Approvals</h1>
            <p class="text-muted small mb-0">Queued and on-hold requisitions awaiting action.</p>
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">@err</div>
        }

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No requisitions awaiting action.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Requestor</th>
                                <th>Division</th>
                                <th>Type</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var statusDisplay = QueuePositionHelper.FormatQueueStatus(row.Status, queuePositions.GetValueOrDefault(row.Id));
                                <tr>
                                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@row.RequestorName</td>
                                    <td>@row.RequestorDivision</td>
                                    <td>@(row.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</td>
                                    <td>@row.ItemCount</td>
                                    <td>
                                        @statusDisplay
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-dark">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
