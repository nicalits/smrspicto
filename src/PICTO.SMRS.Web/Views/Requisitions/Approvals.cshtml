@using PICTO.SMRS.Web.Models.Requisitions
@model IReadOnlyList<RequisitionApprovalRowViewModel>
@{
    ViewData["Title"] = "Requisition Approvals";
}

<div class="smrs-page">
    <div class="smrs-card smrs-card--page">
        <header class="smrs-page-header">
            <h1 class="h3 text-navy mb-1">Requisition Approvals</h1>
            
        </header>

        @if (TempData["StatusMessage"] is string ok)
        {
            <div class="alert alert-success mt-4 mb-0" role="alert">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">@err</div>
        }

        <section class="smrs-section mt-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No requisitions available for your approval queue.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                                               <th>Date</th>
                                <th>Requestor</th>
                                <th>Division</th>
                                <th>Type</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th>Under use</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var badgeClass = row.Status switch
                                {
                                    RequisitionStatus.Approved => "bg-success",
                                    RequisitionStatus.Rejected => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                                <tr>
                                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@row.RequestorName</td>
                                    <td>@row.RequestorDivision</td>
                                    <td>@(row.ItemType == RequisitionItemType.ItSupplies ? "IT" : "Office")</td>
                                    <td>@row.ItemCount</td>
                                    <td>
                                        <span class="badge @badgeClass">@row.Status</span>
                                    </td>
                                    <td>
                                        @if (row.Status == RequisitionStatus.Approved)
                                        {
                                            if (row.MarkedInUseAt is not null)
                                            {
                                                <span class="badge bg-primary">In use</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Awaiting issuance</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                            <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">View</a>
                                            @if (row.Status == RequisitionStatus.Approved && row.MarkedInUseAt is null)
                                            {
                                                <form asp-action="CancelApproval" method="post" class="d-inline"
                                                      onsubmit="return confirm('Cancel this approval? The requisition will return to Pending and will no longer be ready for checker issuance.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <button type="submit" class="btn btn-sm btn-warning">Cancel approval</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
