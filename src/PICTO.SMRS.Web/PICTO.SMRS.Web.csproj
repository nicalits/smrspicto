<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-PICTO.SMRS.Web-9edb7776-8e13-44f8-9673-7437bf633f54</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Defensive: exclude build artifacts if they ever get picked up by globbing. -->
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="_build_verify*\**\*.cs" />
    <Compile Remove="_obj_verify*\**\*.cs" />
    <EmbeddedResource Remove="bin\**\*" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="_build_verify*\**\*" />
    <EmbeddedResource Remove="_obj_verify*\**\*" />
    <Content Remove="bin\**\*" />
    <Content Remove="obj\**\*" />
    <Content Remove="_build_verify*\**\*" />
    <Content Remove="_obj_verify*\**\*" />
    <None Remove="bin\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="_build_verify*\**\*" />
    <None Remove="_obj_verify*\**\*" />
  </ItemGroup>

</Project>
